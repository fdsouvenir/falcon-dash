{
	"id": "falcon-dash",
	"name": "Falcon Dash",
	"version": "4.0.2",
	"description": "Falcon Dash OpenClaw plugin: Work, Integrations, KeePassXC Vault and Documents (implementation preview)",
	"activation": {
		"onStartup": true
	},
	"contracts": {
		"tools": ["falcon_work", "falcon_integrations", "falcon_vault", "falcon_documents"],
		"gatewayMethodDispatch": ["authenticated-request"]
	},
	"configSchema": {
		"type": "object",
		"additionalProperties": false,
		"properties": {
			"dataDir": {
				"type": "string"
			},
			"modules": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"work": {
						"type": "boolean"
					},
					"integrations": {
						"type": "boolean"
					},
					"vault": {
						"type": "boolean"
					},
					"documents": {
						"type": "boolean"
					}
				}
			},
			"vaultOwners": {
				"type": "array",
				"items": {
					"type": "string"
				}
			},
			"vaultExecutors": {
				"type": "array",
				"items": {
					"type": "string"
				}
			},
			"documentRoots": {
				"type": "array",
				"items": {
					"type": "object",
					"additionalProperties": false,
					"required": ["id", "path", "actors"],
					"properties": {
						"id": {
							"type": "string"
						},
						"path": {
							"type": "string"
						},
						"actors": {
							"type": "array",
							"items": {
								"type": "string"
							}
						},
						"writable": {
							"type": "boolean"
						}
					}
				}
			},
			"oauthRedirectUris": {
				"type": "array",
				"items": {
					"type": "string"
				},
				"maxItems": 10
			}
		}
	},
	"secretProviderIntegrations": {
		"keepassxc": {
			"providerAlias": "falcon-vault",
			"displayName": "Falcon KeePassXC Vault",
			"source": "exec",
			"command": "${node}",
			"args": ["./plugin/vault/resolve-secrets.mjs"],
			"passEnv": ["PATH", "FALCON_VAULT_DIRECTORY"],
			"jsonOnly": true,
			"timeoutMs": 20000,
			"maxOutputBytes": 1048576
		}
	},
	"controlUi": {
		"entry": "dist/control-ui/falcon/index.js",
		"styles": ["dist/control-ui/falcon/index.css"]
	}
}
