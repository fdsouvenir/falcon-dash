{
	"id": "falcon-dash",
	"name": "Falcon Dash",
	"version": "4.0.0-alpha.0",
	"description": "Falcon Dash OpenClaw plugin: Work, Integrations, KeePassXC Vault and Documents (implementation preview)",
	"activation": {
		"onStartup": true
	},
	"contracts": {
		"tools": ["falcon_work", "falcon_integrations", "falcon_vault", "falcon_documents"],
		"gatewayMethodDispatch": ["authenticated-request"]
	},
	"configSchema": {
		"type": "object",
		"additionalProperties": false,
		"properties": {
			"dataDir": {
				"type": "string"
			},
			"modules": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"work": {
						"type": "boolean"
					},
					"integrations": {
						"type": "boolean"
					},
					"vault": {
						"type": "boolean"
					},
					"documents": {
						"type": "boolean"
					}
				}
			},
			"vaultOwners": {
				"type": "array",
				"items": {
					"type": "string"
				}
			},
			"vaultExecutors": {
				"type": "array",
				"items": {
					"type": "string"
				}
			},
			"documentRoots": {
				"type": "array",
				"items": {
					"type": "object",
					"additionalProperties": false,
					"required": ["id", "path", "actors"],
					"properties": {
						"id": {
							"type": "string"
						},
						"path": {
							"type": "string"
						},
						"actors": {
							"type": "array",
							"items": {
								"type": "string"
							}
						},
						"writable": {
							"type": "boolean"
						}
					}
				}
			}
		}
	}
}
