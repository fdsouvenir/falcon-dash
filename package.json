{
	"name": "@fdsouvenir/falcon-dash",
	"version": "4.0.0-alpha.0",
	"description": "Falcon Dash OpenClaw plugin: Work, Integrations, KeePassXC Vault and Documents (implementation preview)",
	"repository": {
		"type": "git",
		"url": "https://github.com/fdsouvenir/falcon-dash.git"
	},
	"homepage": "https://github.com/fdsouvenir/falcon-dash#readme",
	"bugs": {
		"url": "https://github.com/fdsouvenir/falcon-dash/issues"
	},
	"author": "fdsouvenir",
	"license": "CC-BY-NC-ND-4.0",
	"keywords": [
		"openclaw",
		"dashboard",
		"ai",
		"ai-agents",
		"operator-console",
		"sveltekit",
		"websocket"
	],
	"type": "module",
	"files": [
		"plugin/",
		"openclaw.plugin.json",
		"scripts/build-plugin.mjs",
		"docs/Technical/plugin-v4.md",
		"docs/Technical/plugin-v4-evidence.md",
		"docs/Technical/plugin-v4-backend.md",
		"plugin/schema.mjs",
		"plugin/typebox-license.txt",
		"dist/control-ui/",
		"docs/Technical/plugin-v4-native-ui.md",
		"docs/Technical/plugin-native-e2e.md",
		"docs/Technical/plugin-v4-scope.md",
		"docs/Technical/plugin-v4-installation.md"
	],
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"engines": {
		"node": ">=22.16"
	},
	"scripts": {
		"build": "node scripts/build-plugin.mjs",
		"build:cli": "node scripts/build-cli.mjs",
		"analyze": "ANALYZE=true vite build",
		"agent:loop": "node scripts/agent-loop.mjs",
		"console:sweep": "node scripts/console-sweep.mjs",
		"preview": "vite preview",
		"check": "tsc --allowJs --checkJs --noEmit --module nodenext --moduleResolution nodenext --target es2022 --skipLibCheck plugin/index.mjs",
		"check:docs": "node scripts/check-doc-freshness.mjs",
		"check:harness": "node scripts/check-harness-docs.mjs",
		"check:skills": "node scripts/check-skills.mjs",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "node --test --test-concurrency=1 plugin/tests/*.test.mjs",
		"test:watch": "vitest",
		"test:coverage": "node --experimental-test-coverage --test-coverage-include='plugin/**/*.mjs' --test-coverage-exclude='plugin/schema.mjs' --test-coverage-exclude='plugin/tests/**' --test --test-concurrency=1 plugin/tests/*.test.mjs",
		"test:ui": "vitest --ui",
		"prepublishOnly": "npm run build:plugin && npm run test:plugin",
		"release": "npm version",
		"test:e2e": "npm run test:native-e2e",
		"test:e2e:headed": "npm run test:native-e2e -- --headed",
		"test:e2e:install": "playwright install chromium",
		"test:e2e:ui": "npm run test:native-e2e -- --ui",
		"test:e2e:report": "playwright show-report artifacts/plugin-v4/native-playwright-report",
		"test:plugin": "node --test --test-concurrency=1 plugin/tests/*.test.mjs",
		"build:plugin": "node scripts/build-plugin.mjs",
		"build:historical-standalone": "vite build",
		"dev:historical-standalone": "vite dev",
		"check:plugin": "tsc --allowJs --checkJs --noEmit --module nodenext --moduleResolution nodenext --target es2022 --skipLibCheck plugin/index.mjs",
		"test:historical-standalone": "vitest run",
		"check:historical-standalone": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test:coverage:historical-standalone": "vitest run --coverage",
		"precheck": "npm run build",
		"pretest": "npm run build",
		"pretest:coverage": "npm run build",
		"test:managed-runtime": "npm run build && node scripts/verify-managed-install.mjs",
		"test:native-e2e": "npm run build && node scripts/run-native-e2e.mjs",
		"test:native-host": "npm run build && node scripts/run-native-e2e.mjs --host-only",
		"test:e2e:historical-standalone": "playwright test --config playwright.historical.config.ts"
	},
	"lint-staged": {
		"*.{js,ts,svelte}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,md,css,html,yaml,yml}": [
			"prettier --write"
		]
	},
	"devDependencies": {
		"@eslint/js": "^10.0.0",
		"@internationalized/date": "^3.11.0",
		"@lucide/svelte": "^0.575.0",
		"@playwright/test": "^1.56.1",
		"@sentry/sveltekit": "^10.39.0",
		"@sentry/vite-plugin": "^4.9.1",
		"@sveltejs/adapter-node": "^5.5.3",
		"@sveltejs/kit": "^2.15.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@tailwindcss/vite": "^4.0.0",
		"@toon-format/toon": "4.0.0",
		"@types/better-sqlite3": "^7.6.13",
		"@types/katex": "^0.16.8",
		"@types/node": "^25.3.0",
		"@types/ws": "^8.18.1",
		"@vitest/coverage-v8": "^4.0.18",
		"@vitest/ui": "^4.0.18",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/addon-web-links": "^0.12.0",
		"@xterm/xterm": "^6.0.0",
		"axi-sdk-js": "0.1.8",
		"better-sqlite3": "^12.6.2",
		"bits-ui": "^2.16.2",
		"clsx": "^2.1.1",
		"esbuild": "^0.28.1",
		"eslint": "^10.0.0",
		"eslint-config-prettier": "^10.0.0",
		"eslint-plugin-svelte": "^3.15.0",
		"globals": "^17.3.0",
		"happy-dom": "^20.7.0",
		"husky": "^9.1.7",
		"ipaddr.js": "^2.4.0",
		"katex": "^0.16.28",
		"lint-staged": "^16.2.7",
		"mermaid": "^11.12.2",
		"node-pty": "^1.1.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"rehype-katex": "^7.0.1",
		"rehype-raw": "^7.0.0",
		"rehype-sanitize": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-gfm": "^4.0.1",
		"remark-math": "^6.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"rollup-plugin-visualizer": "^7.0.1",
		"shiki": "^3.22.0",
		"svelte": "^5.53.0",
		"svelte-check": "^4.4.3",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.2.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.7.0",
		"typescript-eslint": "^8.0.0",
		"unified": "^11.0.5",
		"vite": "^7.0.0",
		"vitest": "^4.0.18",
		"web-vitals": "^5.1.0",
		"ws": "^8.19.0",
		"typebox": "1.3.18"
	},
	"openclaw": {
		"extensions": [
			"./plugin/index.mjs"
		],
		"compat": {
			"pluginApi": "2026.9.2",
			"minGatewayVersion": "2026.9.2"
		},
		"build": {
			"openclawVersion": "2026.9.2",
			"pluginSdkVersion": "2026.9.2"
		}
	},
	"peerDependencies": {
		"openclaw": "2026.9.2"
	},
	"peerDependenciesMeta": {
		"openclaw": {
			"optional": true
		}
	}
}
